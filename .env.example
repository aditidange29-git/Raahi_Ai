# ─── Raahi AI — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Model Provider ─────────────────────────────────────────────────────────────
# Options: bedrock (default) | openai
RAAHI_MODEL_PROVIDER=bedrock

# ── Amazon Bedrock (default) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Model ID — Claude Sonnet 4 on Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5

# ── OpenAI (optional fallback) ─────────────────────────────────────────────────
# RAAHI_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_ID=gpt-4o

# ── Database ───────────────────────────────────────────────────────────────────
# Default: raahi.db in project root (SQLite)
DB_PATH=raahi.db

# ── Frontend ───────────────────────────────────────────────────────────────────
# VITE_API_URL is used by the frontend to reach the backend.
# Leave empty when using the Vite proxy (dev), set to your backend URL in prod.
VITE_API_URL=
